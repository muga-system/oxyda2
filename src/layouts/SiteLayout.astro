---
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { version } from '../../package.json';

interface Props {
  title?: string;
  description?: string;
}
const {
  title,
  description = 'Matemática para pensar, no solamente para calcular. Recuperá conocimientos con situaciones cotidianas, a tu ritmo.',
} = Astro.props;
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const canonicalUrl = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).toString()
  : undefined;
const links = [
  { href: '/', label: 'Inicio', desktop: false },
  { href: '/aprender', label: 'Aprender', desktop: true },
  { href: '/recordar', label: 'Recordar', desktop: true },
  { href: '/prueba', label: 'Poneme a prueba', desktop: true },
  { href: '/mapa', label: 'Mi mapa', desktop: true },
] as const;
const isCurrent = (href: string) =>
  href === '/' ? pathname === '/' : pathname.startsWith(href);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#000000" />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <ClientRouter />
    <title>
      {title ? `${title} · OxYda2` : 'OxYda2 · Matemática para pensar'}
    </title>
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <header class="site-header">
      <div class="site-header__inner">
        <a class="brand" href="/" aria-label="OxYda2, inicio">
          <img
            class="brand__mark"
            src="/brand/monograma-128.png"
            width="24"
            height="24"
            alt=""
            decoding="async"
          />
          <span class="brand__name" aria-hidden="true">OxYda2</span>
        </a>
        <nav class="site-nav" aria-label="Principal">
          {
            links
              .filter((link) => link.desktop)
              .map((link) => (
                <a
                  href={link.href}
                  aria-current={isCurrent(link.href) ? 'page' : undefined}
                >
                  {link.label}
                </a>
              ))
          }
        </nav>
        <details class="mobile-menu">
          <summary class="mobile-menu__trigger">
            <span class="mobile-menu__icon" aria-hidden="true">
              <span></span>
              <span></span>
            </span>
            Menú
          </summary>
          <nav class="mobile-menu__links" aria-label="Navegación móvil">
            {
              links.map((link) => (
                <a
                  href={link.href}
                  aria-current={isCurrent(link.href) ? 'page' : undefined}
                >
                  {link.label}
                </a>
              ))
            }
          </nav>
        </details>
      </div>
    </header>
    <main id="contenido" tabindex="-1" class="frame">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="site-footer__inner">
        <span>OxYda2 · Matemática disponible.</span>
        <span class="site-footer__version">v{version}</span>
      </div>
    </footer>
    <noscript
      ><p class="noscript-message">
        Podés consultar los conceptos. Para resolver desafíos y guardar tu
        progreso, activá JavaScript en tu navegador.
      </p></noscript
    >
  </body>
</html>
