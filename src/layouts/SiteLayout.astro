---
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import NavigationLink from '../components/react/NavigationLink';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title?: string;
  description?: string;
  home?: boolean;
}
const {
  title,
  description = 'Matemática para pensar, no solamente para calcular. Recuperá conocimientos con situaciones cotidianas, a tu ritmo.',
  home = false,
} = Astro.props;
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const runner = pathname.startsWith('/desafio/') || pathname === '/prueba';
const challengeRunner = pathname.startsWith('/desafio/');
const canonicalUrl = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).toString()
  : undefined;
const links = [
  { href: '/', label: 'Inicio', icon: 'home' },
  { href: '/aprender', label: 'Aprender', icon: 'book-open' },
  { href: '/recordar', label: 'Recordar', icon: 'search' },
  { href: '/prueba', label: 'Poneme a prueba', icon: 'scan-line' },
  { href: '/mapa', label: 'Mi mapa', icon: 'map' },
] as const;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b0b0f" />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <ClientRouter />
    <title>
      {title ? `${title} · OxYda2` : 'OxYda2 · Matemática para pensar'}
    </title>
  </head>
  <body
    class:list={[
      home && 'home-layout',
      runner && 'runner-layout',
      challengeRunner && 'challenge-runner-layout',
    ]}
  >
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <header class="site-header site-header-app">
      <a class="brand" href="/" aria-label="OxYda2, inicio">
        <img
          class="brand__mark"
          src="/brand/monograma-128.png"
          width="42"
          height="42"
          alt=""
          decoding="async"
        />
        <span class="sr-only">OxYda2</span>
      </a>
      <nav class="home-nav" aria-label="Principal">
        {
          links.map((link) => (
            <NavigationLink
              href={link.href}
              label={link.label}
              icon={link.icon}
              variant="top"
              current={
                link.href === '/'
                  ? pathname === '/'
                  : pathname.startsWith(link.href)
              }
              client:load
            />
          ))
        }
      </nav>
    </header>
    <div
      class:list={[
        'site-frame',
        home && 'site-frame-home',
        runner && 'site-frame-runner',
      ]}
    >
      <main id="contenido" tabindex="-1"><slot /></main>
    </div>
    <footer class="site-footer">
      <span>OxYda2 <span class="muted">/</span> Matemática disponible.</span>
      <span>Sin cuenta. Progreso en este navegador.</span>
    </footer>
    <noscript
      ><p class="noscript-message">
        Podés consultar los conceptos. Para resolver desafíos y guardar tu
        progreso, activá JavaScript en tu navegador.
      </p></noscript
    >
  </body>
</html>
