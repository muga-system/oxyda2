---
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  home?: boolean;
}
const {
  title,
  description = 'Matemática para pensar, no solamente para calcular. Recuperá conocimientos con situaciones cotidianas, a tu ritmo.',
  home = false,
} = Astro.props;
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const links = [
  { href: '/', label: 'Inicio', number: '00' },
  { href: '/aprender', label: 'Aprender', number: '01' },
  { href: '/recordar', label: 'Recordar', number: '02' },
  { href: '/prueba', label: 'Poneme a prueba', number: '03' },
  { href: '/mapa', label: 'Mi mapa', number: '04' },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b0b0f" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>
      {title ? `${title} · OxYda2` : 'OxYda2 · Matemática para pensar'}
    </title>
  </head>
  <body class:list={[home && 'home-layout']}>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <header class="site-header">
      <a class="brand" href="/" aria-label="OxYda2, inicio"
        >Ox<span>Y</span>da<span class="brand-two">2</span></a
      >
      <span class="header-note"
        ><span class="local-dot" aria-hidden="true"></span> Un espacio para pensar</span
      >
    </header>
    <div class:list={['site-frame', home && 'site-frame-home']}>
      {
        !home && (
          <nav class="primary-nav" aria-label="Principal">
            {links.map((link) => (
              <a
                href={link.href}
                aria-current={
                  (
                    link.href === '/'
                      ? pathname === '/'
                      : pathname.startsWith(link.href)
                  )
                    ? 'page'
                    : undefined
                }
              >
                <span>{link.label}</span>
              </a>
            ))}
            <p class="nav-footnote">
              Sin apuro.
              <br />
              Con sentido.
            </p>
          </nav>
        )
      }
      <main id="contenido" tabindex="-1"><slot /></main>
    </div>
    <footer class="site-footer">
      <span>OxYda2 <span class="muted">/</span> Matemática disponible.</span>
      <span>Sin cuenta. Progreso en este navegador.</span>
    </footer>
    <noscript
      ><p class="noscript-message">
        Podés consultar los conceptos. Para resolver desafíos y guardar tu
        progreso, activá JavaScript en tu navegador.
      </p></noscript
    >
  </body>
</html>
