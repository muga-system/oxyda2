---
import SiteLayout from '../../layouts/SiteLayout.astro';
import PageHead from '../../components/astro/PageHead.astro';
import { challenges } from '../../content/challenges';
import { families } from '../../content/skills';
import { familyIllustrations } from '../../shared/ui/illustrations';
---

<SiteLayout title="Desafíos">
  <PageHead
    label="Desafíos"
    title="Elegí una situación para poner una idea en juego."
    description="Todas las situaciones están disponibles. Podés seguir el recorrido, volver a una idea o entrar donde tengas curiosidad."
  />
  {
    families.map((family, familyIndex) => {
      const familyChallenges = challenges.filter(
        (challenge) => challenge.familyId === family.id,
      );
      return (
        <section class="row" aria-labelledby={`challenge-family-${family.id}`}>
          <div class="cell cell--intro challenge-group">
            <img
              src={familyIllustrations[family.id].src}
              width="56"
              height="56"
              alt=""
            />
            <span class="label">
              {String(familyIndex + 1).padStart(2, '0')} — Familia
            </span>
            <h2 id={`challenge-family-${family.id}`}>{family.title}</h2>
            <p>{family.description}</p>
          </div>
          <ol class="cell cell--wide cell--flush link-list link-list--rich">
            {familyChallenges.map((challenge) => (
              <li>
                <a href={`/desafio/${challenge.slug}`} data-astro-reload>
                  <span class="link-list__number">
                    {String(challenges.indexOf(challenge) + 1).padStart(2, '0')}
                  </span>
                  <span class="link-list__copy">
                    <span class="link-list__title">{challenge.title}</span>
                    <span class="link-list__description">
                      {challenge.scenario}
                    </span>
                  </span>
                  <span class="link-list__meta">
                    {challenge.steps.length} pasos →
                  </span>
                </a>
              </li>
            ))}
          </ol>
        </section>
      );
    })
  }
</SiteLayout>
