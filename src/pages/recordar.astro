---
import SiteLayout from '../layouts/SiteLayout.astro';
import PageHead from '../components/astro/PageHead.astro';
import RecallSearchIsland from '../modules/recall/ui/RecallSearchIsland';
import { recallCards } from '../content/recall';
import { families } from '../content/skills';
import { areaIllustrations } from '../shared/ui/illustrations';
---

<SiteLayout title="Recordar">
  <PageHead
    label="Recordar"
    title="La relación justa, cuando la necesitás."
    description="Una relación, una explicación breve y un ejemplo. Sin recorrer un curso entero."
    illustration={areaIllustrations.recall}
  />
  <RecallSearchIsland client:load cards={recallCards} families={families} />
</SiteLayout>
