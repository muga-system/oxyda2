---
import SiteLayout from '../layouts/SiteLayout.astro';
import PageHead from '../components/astro/PageHead.astro';
import ProgressMapIsland from '../modules/progress/ui/ProgressMapIsland';
import { families, skills } from '../content/skills';
import { areaIllustrations } from '../shared/ui/illustrations';
---

<SiteLayout title="Mi mapa">
  <PageHead
    label="Mi mapa"
    title="Qué está firme y qué conviene refrescar."
    description="Dominio y frescura se leen por separado. Una habilidad sólida puede necesitar un repaso, y eso no borra lo aprendido."
    illustration={areaIllustrations.map}
  />
  <ProgressMapIsland client:load families={families} skills={skills} />
</SiteLayout>
