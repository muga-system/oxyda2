---
import SiteLayout from '../layouts/SiteLayout.astro';
import { AnimatedArrowLink } from '../components/react/AnimatedArrowAction';
---

<SiteLayout title="Página no encontrada">
  <div class="empty-state">
    <h1>Por acá no hay un desafío.</h1><p>
      Es posible que el enlace haya cambiado. Desde el inicio podés elegir otra
      situación.
    </p><AnimatedArrowLink
      client:load
      className="button button-primary"
      href="/"
    >
      Volver al inicio
    </AnimatedArrowLink>
  </div>
</SiteLayout>
