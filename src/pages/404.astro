---
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout title="Página no encontrada">
  <div class="empty-state">
    <h1>Por acá no hay un desafío.</h1><p>
      Es posible que el enlace haya cambiado. Desde el inicio podés elegir otra
      situación.
    </p><a class="button button-primary" href="/"
      >Volver al inicio <span aria-hidden="true">→</span></a
    >
  </div>
</SiteLayout>
