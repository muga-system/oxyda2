---
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout title="Página no encontrada">
  <section class="row">
    <div class="cell cell--full empty-state">
      <span class="label">404</span>
      <h1>Por acá no hay un desafío.</h1>
      <p>
        Es posible que el enlace haya cambiado. Desde el inicio podés elegir
        otra situación.
      </p>
      <a class="button button-primary" href="/">Volver al inicio →</a>
    </div>
  </section>
</SiteLayout>
