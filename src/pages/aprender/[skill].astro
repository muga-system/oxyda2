---
import type { GetStaticPaths } from 'astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import PageHead from '../../components/astro/PageHead.astro';
import FamilyStatusIsland from '../../modules/learning/ui/FamilyStatusIsland';
import FamilyConceptsIsland from '../../modules/learning/ui/FamilyConceptsIsland';
import { families, skills } from '../../content/skills';
import { challenges } from '../../content/challenges';
import { familyIllustrations } from '../../shared/ui/illustrations';

export const getStaticPaths = (() =>
  families.map((family) => ({
    params: { skill: family.slug },
    props: { family },
  }))) satisfies GetStaticPaths;
const { family } = Astro.props;
const familyIndex = families.indexOf(family) + 1;
const familySkills = skills.filter((skill) => skill.familyId === family.id);
const relatedChallenges = challenges.filter(
  (challenge) => challenge.familyId === family.id,
);
---

<SiteLayout title={family.title}>
  <nav class="crumbs" aria-label="Ruta">
    <a href="/aprender">Aprender</a>
    <span aria-hidden="true">/</span>
    <span aria-current="page">{family.title}</span>
  </nav>
  <PageHead
    label={`${String(familyIndex).padStart(2, '0')} — ${family.title}`}
    title={family.question}
    description={family.description}
    illustration={familyIllustrations[family.id]}
  >
    <FamilyStatusIsland client:load skills={familySkills} />
  </PageHead>
  <FamilyConceptsIsland
    client:load
    familyTitle={family.title}
    skills={familySkills}
    challenges={relatedChallenges}
  />
  <section class="row" aria-labelledby="related-title">
    <div class="cell cell--intro">
      <span class="label">Situaciones</span>
      <h2 id="related-title">Desafíos de {family.title.toLowerCase()}</h2>
    </div>
    <ol class="cell cell--wide link-list">
      {
        relatedChallenges.map((challenge) => (
          <li>
            <a
              href={`/desafio/${challenge.slug}?source=learning`}
              data-astro-reload
            >
              <span class="link-list__title">{challenge.title}</span>
              <span class="link-list__meta">
                {challenge.steps.length} pasos →
              </span>
            </a>
          </li>
        ))
      }
    </ol>
  </section>
</SiteLayout>
