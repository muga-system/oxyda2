---
import SiteLayout from '../../layouts/SiteLayout.astro';
import PageHead from '../../components/astro/PageHead.astro';
import LearningOverviewIsland from '../../modules/learning/ui/LearningOverviewIsland';
import { families, skills } from '../../content/skills';
import { areaIllustrations } from '../../shared/ui/illustrations';
---

<SiteLayout title="Aprender">
  <PageHead
    label="Aprender"
    title="Conceptos breves, en orden."
    description="Cinco familias para entender relaciones que aparecen todos los días. Todos los conceptos están abiertos: la progresión orienta, vos elegís el recorrido."
    illustration={areaIllustrations.learn}
  />
  <LearningOverviewIsland client:load families={families} skills={skills} />
</SiteLayout>
